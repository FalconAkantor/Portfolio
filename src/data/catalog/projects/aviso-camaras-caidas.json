eo-node{stroke:#2b3848;}#dg-aviso-camaras-caidas [data-look=\"neo\"].node rect,#dg-aviso-camaras-caidas [data-look=\"neo\"].cluster rect,#dg-aviso-camaras-caidas [data-look=\"neo\"].node polygon{stroke:url(#dg-aviso-camaras-caidas-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#dg-aviso-camaras-caidas [data-look=\"neo\"].swimlane.cluster rect{filter:none;}#dg-aviso-camaras-caidas [data-look=\"neo\"].node path{stroke:url(#dg-aviso-camaras-caidas-gradient);stroke-width:1px;}#dg-aviso-camaras-caidas [data-look=\"neo\"].node .outer-path{filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#dg-aviso-camaras-caidas [data-look=\"neo\"].node .neo-line path{stroke:#2b3848;filter:none;}#dg-aviso-camaras-caidas [data-look=\"neo\"].node circle{stroke:url(#dg-aviso-camaras-caidas-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#dg-aviso-camaras-caidas [data-look=\"neo\"].node circle .state-start{fill:#000000;}#dg-aviso-camaras-caidas [data-look=\"neo\"].icon-shape .icon{fill:url(#dg-aviso-camaras-caidas-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#dg-aviso-camaras-caidas [data-look=\"neo\"].icon-shape .icon-neo path{stroke:url(#dg-aviso-camaras-caidas-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#dg-aviso-camaras-caidas :root{--mermaid-font-family:\"trebuchet ms\",verdana,arial,sans-serif;}</style><g><marker id=\"dg-aviso-camaras-caidas_flowchart-v2-pointEnd\" class=\"marker flowchart-v2\" viewBox=\"0 0 10 10\" refX=\"5\" refY=\"5\" markerUnits=\"userSpaceOnUse\" markerWidth=\"8\" markerHeight=\"8\" orient=\"auto\"><path d=\"M 0 0 L 10 5 L 0 10 z\" class=\"arrowMarkerPath\" style=\"stroke-width: 1; stroke-dasharray: 1, 0;\"></path></marker><marker id=\"dg-aviso-camaras-caidas_flowchart-v2-pointStart\" class=\"marker flowchart-v2\" viewBox=\"0 0 10 10\" refX=\"4.5\" refY=\"5\" markerUnits=\"userSpaceOnUse\" markerWidth=\"8\" markerHeight=\"8\" orient=\"auto\"><path d=\"M 0 5 L 10 10 L 10 0 z\" class=\"arrowMarkerPath\" style=\"stroke-width: 1; stroke-dasharray: 1, 0;\"></path></marker><marker id=\"dg-aviso-camaras-caidas_flowchart-v2-pointEnd-margin\" class=\"marker flowchart-v2\" viewBox=\"0 0 11.5 14\" refX=\"11.5\" refY=\"7\" markerUnits=\"userSpaceOnUse\" markerWidth=\"10.5\" markerHeight=\"14\" orient=\"auto\"><path d=\"M 0 0 L 11.5 7 L 0 14 z\" class=\"arrowMarkerPath\" style=\"stroke-width: 0; stroke-dasharray: 1, 0;\"></path></marker><marker id=\"dg-aviso-camaras-caidas_flowchart-v2-pointStart-margin\" class=\"marker flowchart-v2\" viewBox=\"0 0 11.5 14\" refX=\"1\" refY=\"7\" markerUnits=\"userSpaceOnUse\" markerWidth=\"11.5\" markerHeight=\"14\" orient=\"auto\"><polygon points=\"0,7 11.5,14 11.5,0\" class=\"arrowMarkerPath\" style=\"stroke-width: 0; stroke-dasharray: 1, 0;\"></polygon></marker><marker id=\"dg-aviso-camaras-caidas_flowchart-v2-circleEnd\" class=\"marker flowchart-v2\" viewBox=\"0 0 10 10\" refX=\"11\" refY=\"5\" markerUnits=\"userSpaceOnUse\" markerWidth=\"11\" markerHeight=\"11\" orient=\"auto\"><circle cx=\"5\" cy=\"5\" r=\"5\" class=\"arrowMarkerPath\" style=\"stroke-width: 1; stroke-dasharray: 1, 0;\"></circle></marker><marker id=\"dg-aviso-camaras-caidas_flowchart-v2-circleStart\" class=\"marker flowchart-v2\" viewBox=\"0 0 10 10\" refX=\"-1\" refY=\"5\" markerUnits=\"userSpaceOnUse\" markerWidth=\"11\" markerHeight=\"11\" orient=\"auto\"><circle cx=\"5\" cy=\"5\" r=\"5\" class=\"arrowMarkerPath\" style=\"stroke-width: 1; stroke-dasharray: 1, 0;\"></circle></marker><marker id=\"dg-aviso-camaras-caidas_flowchart-v2-circleEnd-margin\" class=\"marker flowchart-v2\" viewBox=\"0 0 10 10\" refY=\"5\" refX=\"12.25\" markerUnits=\"userSpaceOnUse\" markerWidth=\"14\" markerHeight=\"14\" orient=\"auto\"><circle cx=\"5\" cy=\"5\" r=\"5\" class=\"arrowMarkerPath\" style=\"stroke-width: 0; stroke-dasharray: 1, 0;\"></circle></marker><marker id=\"dg-aviso-camaras-caidas_flowchart-v2-circleStart-margin\" class=\"marker flowchart-v2\" viewBox=\"0 0 10 10