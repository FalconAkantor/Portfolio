cion .image-shape p{background-color:#0b1017;padding:2px;}#dg-kpis-produccion .icon-shape .label rect,#dg-kpis-produccion .image-shape .label rect{opacity:0.5;background-color:#0b1017;fill:#0b1017;}#dg-kpis-produccion .label-icon{display:inline-block;height:1em;overflow:visible;vertical-align:-0.125em;}#dg-kpis-produccion .node .label-icon path{fill:currentColor;stroke:revert;stroke-width:revert;}#dg-kpis-produccion .node .neo-node{stroke:#2b3848;}#dg-kpis-produccion [data-look=\"neo\"].node rect,#dg-kpis-produccion [data-look=\"neo\"].cluster rect,#dg-kpis-produccion [data-look=\"neo\"].node polygon{stroke:url(#dg-kpis-produccion-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#dg-kpis-produccion [data-look=\"neo\"].swimlane.cluster rect{filter:none;}#dg-kpis-produccion [data-look=\"neo\"].node path{stroke:url(#dg-kpis-produccion-gradient);stroke-width:1px;}#dg-kpis-produccion [data-look=\"neo\"].node .outer-path{filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#dg-kpis-produccion [data-look=\"neo\"].node .neo-line path{stroke:#2b3848;filter:none;}#dg-kpis-produccion [data-look=\"neo\"].node circle{stroke:url(#dg-kpis-produccion-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#dg-kpis-produccion [data-look=\"neo\"].node circle .state-start{fill:#000000;}#dg-kpis-produccion [data-look=\"neo\"].icon-shape .icon{fill:url(#dg-kpis-produccion-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#dg-kpis-produccion [data-look=\"neo\"].icon-shape .icon-neo path{stroke:url(#dg-kpis-produccion-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#dg-kpis-produccion :root{--mermaid-font-family:\"trebuchet ms\",verdana,arial,sans-serif;}</style><g><marker id=\"dg-kpis-produccion_flowchart-v2-pointEnd\" class=\"marker flowchart-v2\" viewBox=\"0 0 10 10\" refX=\"5\" refY=\"5\" markerUnits=\"userSpaceOnUse\" markerWidth=\"8\" markerHeight=\"8\" orient=\"auto\"><path d=\"M 0 0 L 10 5 L 0 10 z\" class=\"arrowMarkerPath\" s