monitor-disponibilidad-push .node .neo-node{stroke:#2b3848;}#dg-monitor-disponibilidad-push [data-look=\"neo\"].node rect,#dg-monitor-disponibilidad-push [data-look=\"neo\"].cluster rect,#dg-monitor-disponibilidad-push [data-look=\"neo\"].node polygon{stroke:url(#dg-monitor-disponibilidad-push-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#dg-monitor-disponibilidad-push [data-look=\"neo\"].swimlane.cluster rect{filter:none;}#dg-monitor-disponibilidad-push [data-look=\"neo\"].node path{stroke:url(#dg-monitor-disponibilidad-push-gradient);stroke-width:1px;}#dg-monitor-disponibilidad-push [data-look=\"neo\"].node .outer-path{filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#dg-monitor-disponibilidad-push [data-look=\"neo\"].node .neo-line path{stroke:#2b3848;filter:none;}#dg-monitor-disponibilidad-push [data-look=\"neo\"].node circle{stroke:url(#dg-monitor-disponibilidad-push-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#dg-monitor-disponibilidad-push [data-look=\"neo\"].node circle .state-start{fill:#000000;}#dg-monitor-disponibilidad-push [data-look=\"neo\"].icon-shape .icon{fill:url(#dg-monitor-disponibilidad-push-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#dg-monitor-disponibilidad-push [data-look=\"neo\"].icon-shape .icon-neo path{stroke:url(#dg-monitor-disponibilidad-push-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#dg-monitor-disponibilidad-push :root{--mermaid-font-family:\"trebuchet ms\",verdana,arial,sans-serif;}</style><g><marker id=\"dg-monitor-disponibilidad-push_flowchart-v2-pointEnd\" class=\"marker flowchart-v2\" viewBox=\"0 0 10 10\" refX=\"5\" refY=\"5\" markerUnits=\"userSpaceOnUse\" markerWidth=\"8\" markerHeight=\"8\" orient=\"auto\"><path d=\"M 0 0 L 10 5 L 0 10 z\" class=\"arrowMarkerPath\" style=\"stroke-width: 1; stroke-dasharray: 1, 0;\"></path></marker><marker id=\"dg-monitor-disponibilidad-push_flowchart-v2-pointStart\" class=\"marker flowchart-v2\" viewBox=\"