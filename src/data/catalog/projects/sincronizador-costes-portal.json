;}#dg-sincronizador-costes-portal .icon-shape p,#dg-sincronizador-costes-portal .image-shape p{background-color:#0b1017;padding:2px;}#dg-sincronizador-costes-portal .icon-shape .label rect,#dg-sincronizador-costes-portal .image-shape .label rect{opacity:0.5;background-color:#0b1017;fill:#0b1017;}#dg-sincronizador-costes-portal .label-icon{display:inline-block;height:1em;overflow:visible;vertical-align:-0.125em;}#dg-sincronizador-costes-portal .node .label-icon path{fill:currentColor;stroke:revert;stroke-width:revert;}#dg-sincronizador-costes-portal .node .neo-node{stroke:#2b3848;}#dg-sincronizador-costes-portal [data-look=\"neo\"].node rect,#dg-sincronizador-costes-portal [data-look=\"neo\"].cluster rect,#dg-sincronizador-costes-portal [data-look=\"neo\"].node polygon{stroke:url(#dg-sincronizador-costes-portal-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#dg-sincronizador-costes-portal [data-look=\"neo\"].swimlane.cluster rect{filter:none;}#dg-sincronizador-costes-portal [data-look=\"neo\"].node path{stroke:url(#dg-sincronizador-costes-portal-gradient);stroke-width:1px;}#dg-sincronizador-costes-portal [data-look=\"neo\"].node .outer-path{filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#dg-sincronizador-costes-portal [data-look=\"neo\"].node .neo-line path{stroke:#2b3848;filter:none;}#dg-sincronizador-costes-portal [data-look=\"neo\"].node circle{stroke:url(#dg-sincronizador-costes-portal-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#dg-sincronizador-costes-portal [data-look=\"neo\"].node circle .state-start{fill:#000000;}#dg-sincronizador-costes-portal [data-look=\"neo\"].icon-shape .icon{fill:url(#dg-sincronizador-costes-portal-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#dg-sincronizador-costes-portal [data-look=\"neo\"].icon-shape .icon-neo path{stroke:url(#dg-sincronizador-costes-portal-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#dg-sincronizador-costes-portal :root{--mermaid-fo